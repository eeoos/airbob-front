{
  "name": "airbob-front",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.7.0",
  "engines": {
    "node": "^20.12.0 || ^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@tosspayments/tosspayments-sdk": "^2.4.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "axios": "^1.13.1",
    "framer-motion": "^11.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "test:ci:no-cache": "react-scripts test --watchAll=false --no-cache",
    "test:e2e:artifact-policy": "node tests/e2e/support/scan-artifacts.mjs --self-test",
    "test:e2e:characterization": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:architecture": "node scripts/architecture/run-dependency-cruiser.mjs",
    "lint:architecture-tools": "eslint --no-ignore .dependency-cruiser.cjs stylelint.config.mjs scripts/architecture tests/architecture --ext .cjs,.mjs --max-warnings=0",
    "lint:dead-code": "knip --production --preprocessor ./scripts/architecture/knip-target-ratchet.mjs --reporter compact --no-progress && node scripts/architecture/verify-unused-dependency-ratchet.mjs",
    "lint:dead-code:report": "knip --production --reporter compact --no-progress --no-exit-code",
    "lint:e2e": "eslint playwright.config.ts tests/e2e --ext .mjs,.ts --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\" --quiet",
    "lint:styles:report": "stylelint \"src/**/*.css\" --formatter compact",
    "lint:strict": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "smoke:frontend": "node scripts/smoke/frontend-smoke.mjs",
    "smoke:frontend:preflight": "node scripts/smoke/frontend-smoke.mjs --preflight",
    "smoke:frontend:strict": "AIRBOB_SMOKE_STRICT_DYNAMIC_ROUTES=true node scripts/smoke/frontend-smoke.mjs",
    "test:architecture-rules": "node tests/architecture/verify-registry-rules.mjs && node tests/architecture/verify-git-baselines.mjs && node scripts/architecture/verify-architecture-ratchet.mjs && node tests/architecture/verify-dependency-rules.mjs && node tests/architecture/verify-knip-reachability.mjs && node tests/architecture/verify-style-rules.mjs",
    "report:architecture": "npm run lint:dead-code:report && npm run lint:styles:report",
    "verify:architecture": "npm run test:architecture-rules && npm run lint:architecture && npm run lint:dead-code && npm run lint:styles && npm run lint:architecture-tools",
    "verify:structure": "npm run typecheck && npm run verify:architecture && npm run test:ci:no-cache -- --runInBand && npm run lint:strict",
    "verify:pre-redesign": "npm run typecheck && npm run test:ci:no-cache -- --runInBand && npm run build",
    "verify:design-ready": "npm run verify:pre-redesign && npm run smoke:frontend:strict",
    "verify": "npm run typecheck && npm run test:ci:no-cache && npm run build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "playwright.config.ts",
          "tests/e2e/**/*.ts"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off"
        }
      },
      {
        "files": [
          ".dependency-cruiser.cjs",
          "stylelint.config.mjs",
          "scripts/architecture/**/*.{cjs,mjs}",
          "tests/architecture/**/*.mjs",
          "tests/e2e/support/**/*.mjs"
        ],
        "env": {
          "node": true
        },
        "parserOptions": {
          "ecmaVersion": 2022,
          "sourceType": "module"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8080",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/google.maps": "^3.58.1",
    "dependency-cruiser": "17.4.3",
    "knip": "2.43.0",
    "stylelint": "16.23.1",
    "stylelint-config-recommended": "17.0.0",
    "stylelint-config-standard": "39.0.0"
  }
}
