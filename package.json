{
  "name": "airbob-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.7.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tosspayments/tosspayments-sdk": "2.8.1",
    "framer-motion": "^11.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/architecture/validate-public-build-env.mjs && vite build && node scripts/architecture/verify-toss-production-build.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ci:no-cache": "vitest run --coverage --no-cache",
    "test:coverage": "vitest run --coverage",
    "test:e2e:artifact-policy": "node tests/e2e/support/scan-artifacts.mjs --self-test",
    "test:e2e:characterization": "playwright test --project=chromium",
    "test:public-config-build": "node scripts/architecture/verify-public-config-build.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "lint": "eslint src",
    "lint:architecture": "node scripts/architecture/run-dependency-cruiser.mjs",
    "lint:architecture-tools": "eslint --no-ignore eslint.config.mjs .dependency-cruiser.cjs stylelint.config.mjs scripts tests/architecture --max-warnings=0",
    "lint:dead-code": "knip --production --reporter compact --no-progress",
    "lint:dead-code:report": "knip --production --reporter compact --no-progress --no-exit-code",
    "lint:dependencies": "node scripts/architecture/verify-dependency-classification.mjs",
    "lint:e2e": "eslint vite.config.ts vitest.config.ts playwright.config.ts tests/e2e --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\" --quiet",
    "lint:styles:report": "stylelint \"src/**/*.css\" --formatter compact",
    "lint:strict": "eslint src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:frontend": "node scripts/smoke/frontend-smoke.mjs",
    "smoke:frontend:preflight": "node scripts/smoke/frontend-smoke.mjs --preflight",
    "smoke:frontend:strict": "AIRBOB_SMOKE_STRICT_DYNAMIC_ROUTES=true node scripts/smoke/frontend-smoke.mjs",
    "test:architecture-rules": "node tests/architecture/verify-registry-rules.mjs && node tests/architecture/verify-git-baselines.mjs && node scripts/architecture/verify-architecture-ratchet.mjs && node tests/architecture/verify-dependency-rules.mjs && node tests/architecture/verify-knip-reachability.mjs && node tests/architecture/verify-dependency-classification.mjs && node tests/architecture/verify-style-rules.mjs && node tests/architecture/verify-prettier-config.mjs && node tests/architecture/verify-platform-boundary.mjs && node tests/architecture/verify-typescript-config.mjs && node tests/architecture/verify-eslint-config.mjs && node tests/architecture/verify-vite-config.mjs && node tests/architecture/verify-vitest-config.mjs && node tests/architecture/verify-frontend-bundle-budgets.mjs && node tests/architecture/verify-toss-build-gate.mjs && node tests/architecture/verify-toss-runtime.mjs",
    "report:architecture": "npm run lint:dead-code:report && npm run lint:styles:report",
    "verify:architecture": "npm run test:architecture-rules && npm run lint:architecture && npm run lint:dead-code && npm run lint:dependencies && npm run lint:styles && npm run lint:architecture-tools && npm run format:check",
    "verify:structure": "npm run typecheck && npm run typecheck:tooling && npm run verify:architecture && npm run test:public-config-build && npm run test:ci:no-cache && npm run lint:strict",
    "verify:browser": "npm run typecheck:e2e && npm run lint:e2e && npm run test:e2e:artifact-policy && npm run test:e2e:characterization",
    "verify:design-ready": "npm run audit:production && npm run verify:structure && npm run verify:browser",
    "verify:pre-redesign": "npm run verify:design-ready",
    "verify:live-integration": "npm run smoke:frontend:strict",
    "verify": "npm run verify:design-ready"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "4.0.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.11.0",
    "jsdom": "28.1.0",
    "knip": "6.33.0",
    "postcss": "8.5.26",
    "postcss-custom-media": "12.0.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
